# Copy to .env and adjust. Never commit the real .env file.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/csmqp
# Required in production. Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10
# Where uploaded study materials are stored (relative to server/ or absolute)
UPLOAD_DIR=uploads
# Seconds of network grace allowed after a quiz time limit expires
SUBMIT_GRACE_SECONDS=5
CORS_ORIGIN=http://localhost:5173
