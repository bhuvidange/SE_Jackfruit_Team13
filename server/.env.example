# Copy to .env and adjust. Never commit the real .env file.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/csmqp
# Required in production. Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10
# Where uploaded study materials are stored (relative to server/ or absolute)
UPLOAD_DIR=uploads
# Seconds of network grace allowed after a quiz time limit expires
SUBMIT_GRACE_SECONDS=5
# Exact frontend origins, comma-separated only when needed (e.g. local + production Vercel URL).
CORS_ORIGIN=http://localhost:5173
# Max login / registration requests per client IP within the window (each route counted separately)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Login-specific failed-credential lockout: the sixth failed credential check is blocked.
LOGIN_LOCKOUT_MAX_FAILURES=6
LOGIN_LOCKOUT_WINDOW_MS=900000
